{
  "name": "keyrune",
  "description": "Keyrune",
  "version": "3.19.0",
  "author": {
    "name": "Andrew Gioia",
    "email": "andrew@gioia.email",
    "url": "https://andrewgioia.com"
  },
  "contributors": [
    "Mike Gioia <mikegioia@gmail.com>",
    "JayGray <weber.joerg.h@gmail.com>",
    "ardeay",
    "Jordan Brauer <jbrauer.inc@gmail.com>",
    "Corey Csuhta"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/andrewgioia/keyrune.git"
  },
  "keywords": [],
  "homepage": "https://keyrune.andrewgioia.com",
  "devDependencies": {
    "ajv": "^8.20.0",
    "browser-sync": "^3.0.4",
    "chokidar": "^4.0.3",
    "clean-css": "^5.3.3",
    "concurrently": "^9.2.1",
    "less": "^4.4.1",
    "parse5": "^8.0.1"
  },
  "license": "(OFL-1.1 AND GPL-3.0-only)",
  "main": "css/keyrune.css",
  "scripts": {
    "build:css": "node scripts/build.mjs css",
    "build:docs": "node scripts/build.mjs docs",
    "build": "node scripts/build.mjs",
    "watch": "node scripts/watch.mjs",
    "serve": "browser-sync start --server docs --files docs --listen 127.0.0.1 --port 4310 --no-open --no-ui --no-notify",
    "dev": "npm run build && concurrently --kill-others --names watch,serve \"npm:watch\" \"npm:serve\"",
    "fonts:normalize": "node scripts/normalize-fonts.mjs",
    "check": "node scripts/check.mjs",
    "test": "node --test scripts/*.test.mjs",
    "prepack": "npm run build && npm run check",
    "serve:valet": "browser-sync start --config scripts/browser-sync.valet.cjs",
    "dev:valet": "npm run build && concurrently --kill-others --names watch,valet \"npm:watch\" \"npm:serve:valet\"",
    "manifest:check": "node scripts/manifest.mjs",
    "manifest:import": "node scripts/import-manifest.mjs",
    "docs:generate": "node scripts/generate-docs.mjs"
  },
  "bugs": {
    "url": "https://github.com/andrewgioia/keyrune/issues",
    "email": "andrew@gioia.email"
  },
  "files": [
    "css/",
    "fonts/",
    "less/",
    "svg/",
    "CHANGELOG.md"
  ]
}
