{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Keyrune v3 symbol catalog",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "groups",
    "sets"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "const": 1
    },
    "groups": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "sets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code",
          "name",
          "group",
          "added"
        ],
        "properties": {
          "code": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "display": {
            "type": "string",
            "minLength": 1
          },
          "group": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "added": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^\\d+\\.\\d+\\.\\d+$"
              },
              {
                "type": "null"
              }
            ]
          },
          "glyphs": {
            "type": "object",
            "required": [
              "default"
            ],
            "propertyNames": {
              "type": "string",
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
            },
            "additionalProperties": {
              "type": "string",
              "pattern": "^[a-f0-9]{4,6}$"
            }
          },
          "symbolOf": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "aliases": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
            }
          },
          "preview": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "duo": {
                "type": "boolean"
              }
            }
          },
          "docs": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "icon": {
                "type": "boolean"
              }
            }
          },
          "notes": {
            "type": "string",
            "minLength": 1
          }
        },
        "oneOf": [
          {
            "required": [
              "glyphs"
            ],
            "not": {
              "required": [
                "symbolOf"
              ]
            }
          },
          {
            "required": [
              "symbolOf"
            ],
            "not": {
              "required": [
                "glyphs"
              ]
            }
          }
        ]
      }
    }
  }
}
